# LLM credentials are required only for real research runs, not offline tests.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
# Format repair is separate from network retries; default: one correction with feedback.
LLM_MAX_FORMAT_REPAIRS=1
# Opt in to json_object only if your model service supports response_format.
LLM_STRUCTURED_OUTPUT_MODE=prompt
# Compatible gateways may instead set LLM_API_KEY and LLM_BASE_URL (take precedence).
# LLM_BASE_URL=https://myai.bupt.edu.cn/llm-gw/v1
EMBEDDING_MODEL=text-embedding-3-small
PLANNER_MODEL=
REVIEWER_MODEL=
WRITER_MODEL=
SUMMARY_MODEL=

# Explicit durable local mode; API and Worker must use identical absolute paths
# if started from different working directories. Never falls back to memory.
DATABASE_URL=sqlite:///data/research.db
CHECKPOINT_URL=sqlite:///data/checkpoints.db
MEMORY_MARKDOWN_DIR=data/memories
# Docker / deployed mode:
# DATABASE_URL=postgresql+psycopg://research:research@localhost:5432/research
# CHECKPOINT_URL=postgresql://research:research@localhost:5432/research

REQUIRE_HUMAN_APPROVAL=false
MAX_ITERATIONS=3
REQUEST_TIMEOUT=60
TASK_DEADLINE_SECONDS=900
MAX_MODEL_CALLS=100
MAX_TASK_TOKENS=200000
MAX_OUTPUT_TOKENS=4096
MAX_DOCUMENTS=20
BROWSER_BACKEND=http
# chromium requires: uv sync --extra browser; uv run playwright install chromium
AGENT_MAX_STEPS=12
RETRIEVAL_READ_LIMIT=3
MCP_CONFIG_PATH=config/mcp.json
MCP_MAX_RESULT_CHARS=30000
# JSON array; paths are relative to the project working directory unless absolute.
SKILL_DIRS=["skills"]
SKILL_MAX_CHARS=24000
SKILL_CONTEXT_CHARS=48000
WORKER_LEASE_SECONDS=120
WORKER_POLL_SECONDS=2

MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=research_papers
REDIS_URL=redis://localhost:6379/0
S2_API_KEY=
SERPAPI_API_KEY=
TAVILY_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Optional for keys associated with multiple workspaces / org-scoped keys.
LANGSMITH_WORKSPACE_ID=

# 本地固定检索：Windows dsh 风格部分写限制，不隔离读取/网络。
# 先构建 native/windows-sandbox/build.ps1，再重启 API 和 worker。
EXECUTION_ENABLED=false
EXECUTION_ROOT=data/execution
# 空值使用项目内 native/windows-sandbox/bin/research-sandbox.exe；程序不能位于绑定的业务工作空间内。
EXECUTION_HELPER_PATH=
# 空值在服务启动环境 PATH 中查找 rg.exe；不会自动安装。
EXECUTION_RG_PATH=
EXECUTION_TIMEOUT_SECONDS=15
EXECUTION_OUTPUT_BYTES=16384
